# ==============================================================================
# 5. UI BANNER & START PHOTO SETTINGS
# High-resolution image URL or Telegram File ID for /start and Home menus
# ==============================================================================
START_PIC=https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?q=80&w=1200&auto=format&fit=crop

# ==============================================================================
# 6. TASK QUEUE & CONCURRENCY LIMITS
# MAX_CONCURRENT_TASKS : Global active tasks running simultaneously (Default: 3)
# USER_COOLDOWN_SECONDS: Wait time in seconds between tasks for each user (Default: 60)
# ==============================================================================
MAX_CONCURRENT_TASKS=3
USER_COOLDOWN_SECONDS=60

# ==============================================================================
# 7. HIGH-SPEED MEDIA RESOLVER API ENDPOINTS
# Primary and fallback endpoints for TeraBox, Diskwala, and YouTube extractors
# ==============================================================================
