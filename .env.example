SUDO_USERS=2032446867

# ==============================================================================
# 3. FORCE-SUBSCRIBE CHANNELS (Dual Channel Verification)
# Enter public username (without @) or private channel ID (-100xxxxxxxxx)
# ==============================================================================
UPDATES_CHANNEL=SSBotsUpdates
DEALS_CHANNEL=Tg_Shoping

# ==============================================================================
# 4. LOG CHANNEL & MONITORING (Optional)
# Telegram channel ID (e.g. -1001234567890) or username (e.g. SSBotsLogs)
# Receives real-time updates for:
#   - 📢 Bot started & system status
#   - 👤 New user bot started notifications
#   - 📥 New download task queued/added
#   - ✅ Task completed (provider, file name, size, time taken)
#   - 🚫 User ban / unban status updates
# Note: Ensure bot is added as Administrator in the log channel!
# ==============================================================================
