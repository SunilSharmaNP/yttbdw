{
  "name": "TeraBox, Diskwala & YouTube Downloader Bot",
  "description": "Telegram bot using Pyrogram MTProto and Sunil-SSBots API to auto-detect TeraBox, Diskwala, and YouTube links, download media, verify dual channel subscriptions, and upload up to 2GB to Telegram.",
  "repository": "https://github.com/SunilSharmaNP/yttbdw",
  "keywords": ["telegram", "pyrogram", "terabox", "diskwala", "youtube", "mtproto", "downloader", "bot", "forcesub"],
  "stack": "container",
  "buildpacks": [
    {
      "url": "https://github.com/jonathanong/heroku-buildpack-ffmpeg-latest.git"
    },
    {
      "url": "heroku/python"
    }
  ],
  "env": {
    "API_ID": {
      "description": "Telegram API_ID from https://my.telegram.org",
      "required": true
    },
    "API_HASH": {
      "description": "Telegram API_HASH from https://my.telegram.org",
      "required": true
    },
    "BOT_TOKEN": {
      "description": "Telegram Bot Token from @BotFather",
      "required": true
    },
    "OWNER_USERNAME": {
      "description": "Bot Owner Username (without @)",
      "required": false,
      "value": "Sunil_Sharma_2_0_Bot"
    },
    "UPDATES_CHANNEL": {
      "description": "1st Force Sub Channel: Updates Channel (without @)",
      "required": false,
      "value": "SSBotsUpdates"
    },
    "DEALS_CHANNEL": {
      "description": "2nd Force Sub Channel: Loot Deals Channel (without @)",
      "required": false,
      "value": "Tg_Shoping"
    },
    "TERABOX_API_URL": {
      "description": "Sunil-SSBots TeraBox API URL",
      "required": false,
      "value": "https://sunil-ssbots.vercel.app/api/terabox"
    },
    "DISKWALA_API_URL": {
      "description": "Sunil-SSBots Diskwala API URL",
      "required": false,
      "value": "https://sunil-ssbots.vercel.app/api/diskwala"
    },
    "YOUTUBE_API_URL": {
      "description": "Sunil-SSBots YouTube API URL",
      "required": false,
      "value": "https://sunil-ssbots.vercel.app/api/youtube"
    },
    "MAX_FILE_SIZE_MB": {
      "description": "Max file size to download & upload in MB (2048 = 2GB)",
      "required": false,
      "value": "2048"
    },
    "LOG_CHANNEL": {
      "description": "Log Channel ID (e.g. -1003968847525) or username. Note: Add bot as Admin in channel first!",
      "required": false,
      "value": ""
    },
    "MONGO_URI": {
      "description": "MongoDB connection string for persistent users, custom thumbnails, and analytics",
      "required": false,
      "value": ""
    },
    "OWNER_ID": {
      "description": "Telegram user ID of bot owner",
      "required": false,
      "value": "2032446867"
    }
  },
  "formation": {
    "worker": {
      "quantity": 1,
      "size": "basic"
    }
  }
}
