DISKWALA_API_URL=https://sunil-ssbots.vercel.app/api/diskwala
YOUTUBE_API_URL=https://sunil-ssbots.vercel.app/api/youtube
YTULTRA_API_URL=https://api.ytultra.com/ikool/youtube/download

# ==============================================================================
# 8. STORAGE, DOWNLOAD & UPLOAD LIMITS
# DOWNLOAD_DIR     : Directory where temporary media chunks are stored
# MAX_FILE_SIZE_MB : Max file upload limit in MB (2048 MB = 2 GB standard Telegram)
# TERABOX_COOKIES  : Optional cookies (ndus=...) for private / premium TeraBox links
# ==============================================================================
DOWNLOAD_DIR=./downloads
MAX_FILE_SIZE_MB=2048
TERABOX_COOKIES=

# ==============================================================================
# 9. DATABASE CONFIGURATION (Optional - MongoDB)
# Enables persistent user tracking, download analytics, and restart-proof cooldowns
# ==============================================================================
MONGO_URI=
DATABASE_NAME=ss_downloader_bot

# ==============================================================================
# 10. SERVER & AI STUDIO RUNTIME CONFIGURATION
# ==============================================================================
PORT=3000
GEMINI_API_KEY=MY_GEMINI_API_KEY
